# Dashboard login (single admin).
ADMIN_EMAIL=admin@example.com
# Required, at least 12 characters. Placeholders (change-me, a-long-password), well-known weak passwords, values
# with fewer than 5 different characters and the admin email are refused at start. Generate with: openssl rand -base64 18
ADMIN_PASSWORD=
# Required, at least 32 characters with at least 10 different ones, and must not contain ADMIN_PASSWORD.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Address the WordPress sites use to reach this server (shown in the wp-config.php snippet). Use https:// for
# anything beyond this machine: with plain http the password, session cookie and site keys cross the network in
# clear text, and the app logs a warning at start.
PUBLIC_URL=http://localhost:8080
# Host port for the dashboard and ingest API.
APP_PORT=8080
# Host address the port is published on. 127.0.0.1 keeps the app reachable only through a reverse proxy on
# this server. Set 0.0.0.0 to publish it on all interfaces (for example without a proxy on a private network).
APP_BIND=127.0.0.1
# Set to true when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Retention in days. Changes are applied on the next start.
TRANSACTIONS_TTL_DAYS=30
SPANS_TTL_DAYS=7

# ClickHouse credentials, shared by both containers.
CLICKHOUSE_DATABASE=presstrace
CLICKHOUSE_USER=presstrace
# Required. Generate with: openssl rand -hex 16
CLICKHOUSE_PASSWORD=

# Memory limits, sized for a 2 GB VPS. See the sizing docs for larger servers.
CLICKHOUSE_MEM_LIMIT=1200m
APP_MEM_LIMIT=384m
# Cap on report data waiting in the app's memory while ClickHouse is slow or down, in MB.
BUFFER_MAX_MB=64

# Ingest rate limit per site: requests per second and the burst allowed on top. 0 turns the limit off.
INGEST_RATE_PER_SITE=20
INGEST_BURST_PER_SITE=100

# App image tag pulled from ghcr.io/onwp/presstrace.
PRESSTRACE_VERSION=0.1.0
